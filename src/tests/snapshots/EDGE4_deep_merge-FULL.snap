import { z } from "zod"; type Profile = { name?: string; age?: number; }; type User = { profile: Profile; }; type RootObject = { users: User[]; }; const ProfileSchema = z.object({ name: z.string().optional(), age: z.number().optional() }).strict(); const UserSchema = z.object({ profile: ProfileSchema }).strict(); const RootObjectSchema = z.object({ users: z.array(UserSchema) }).strict();