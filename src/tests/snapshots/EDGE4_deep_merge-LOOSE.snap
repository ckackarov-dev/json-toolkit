import { z } from "zod"; const ProfileNameSchema = z.object({ name: z.string() }); const UserProfileSchema = z.object({ profile: ProfileNameSchema }); const ProfileAgeSchema = z.object({ age: z.number() }); const UserProfile1Schema = z.object({ profile: ProfileAgeSchema }); const RootObjectSchema = z.object({ users: z.array(z.object({ profile: z.object({ name: z.string().optional(), age: z.number().optional() }) })) });