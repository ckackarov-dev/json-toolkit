import { z } from "zod"; const UserNameTagSchema = z.object({ name: z.string(), tags: z.array(z.array(z.string())) }); const UserNameTagNullSchema = z.object({ name: z.string(), tags: z.null() }); const RootObjectSchema = z.object({ users: z.array(z.union([UserNameTagSchema, UserNameTagNullSchema])) });